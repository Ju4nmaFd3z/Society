  <diagram id="d0" name="0 · Arranque y S01">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="1380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d0_CC" value="Funciones · qué hace cada una por fuera (backend, APIs externas y datos)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#8c8c8c;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1620" y="150" width="1180" height="1190" as="geometry" />
        </mxCell>
        <mxCell id="d0_CB" value="Pantalla · qué ve y qué hace el usuario (igual en Android y en la web)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#8c8c8c;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="150" width="1000" height="1190" as="geometry" />
        </mxCell>
        <mxCell id="d0_lane1" value="F2 · cargarMiRestaurante() — ¿en qué punto del alta está el usuario?" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f3f7fd;strokeColor=#1a4fa3;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;fontSize=13;fillColor=#fbfbf8;" vertex="1" parent="1">
          <mxGeometry x="1632" y="344" width="1146" height="220" as="geometry" />
        </mxCell>
        <mxCell id="d0_lane0" value="F1 · comprobarSesion() — ¿hay sesión guardada en el dispositivo?" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f3f7fd;strokeColor=#1a4fa3;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;fontSize=13;fillColor=#fbfbf8;" vertex="1" parent="1">
          <mxGeometry x="1632" y="190" width="1146" height="124" as="geometry" />
        </mxCell>
        <mxCell id="d0_title" value="ARRANQUE · S01 BIENVENIDA" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontSize=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="2400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d0_sub" value="Cómo se lee: izquierda, los datos de la pantalla (notas) · centro, el flujo que sigue el usuario y las funciones que lanza (F1, F2…) · derecha, qué hace cada función por fuera: llamada a la API propia, Edge Function o worker Node, APIs externas y tablas. Android: ArranqueViewModel decide el destino inicial del NavHost · Panel web: el guard altaCompletada hace lo mismo. Prioridad P0." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="2740" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d0_n150" value="&lt;b&gt;Clases&lt;/b&gt;&lt;br&gt;• Android: ArranqueViewModel (navigation/) · SesionRepository · RestauranteRepository&lt;br&gt;• Panel web: SesionService (supabase-js) · guard altaCompletada · RestaurantesApi" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d0_n269" value="&lt;b&gt;Datos que maneja&lt;/b&gt;&lt;br&gt;• Sesión: JWT de acceso + refresh. La guardan supabase-kt (Android) y supabase-js (web); nunca se copia a mano&lt;br&gt;• Respuesta de GET /restaurantes/mio: {restaurante: {id, nombre, origen} o null, altaEstado, analisisEnCursoId}&lt;br&gt;• altaEstado: SIN_LOCAL · ANALIZANDO · PENDIENTE_CONFIRMAR · COMPLETADA&lt;br&gt;• Preferencias (DataStore / localStorage): restaurante_id_actual, alta_completada, onboarding_visto" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="269" width="500" height="161" as="geometry" />
        </mxCell>
        <mxCell id="d0_n448" value="&lt;b&gt;S01 · Bienvenida (Figma 01)&lt;/b&gt;&lt;br&gt;• Título «Ideas que llenan tu local», mascota, texto y 3 ventajas&lt;br&gt;• Botón «Descubre cómo funciona» → S01A. Sin datos ni llamadas" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="448" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d0_n567" value="&lt;b&gt;Estado de pantalla&lt;/b&gt;&lt;br&gt;• Cargando (splash) · Destino(ruta) · Error(reintentable)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="567" width="500" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d0_n641" value="&lt;b&gt;Navegación&lt;/b&gt;&lt;br&gt;• Sin sesión → S01 → S01A&lt;br&gt;• Con sesión → S02, S03(analisisId), S04(restauranteId) o S05 según altaEstado" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="641" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d0_gst" value="Abre la app o la web" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="210" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d0_gf1" value="F1 · comprobarSesion() mientras se ve el splash" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
