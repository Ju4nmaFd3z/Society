        <mxCell id="d0_L1r0c0" value="F2 · cargarMiRestaurante()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
