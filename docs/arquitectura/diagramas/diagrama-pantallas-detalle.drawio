        <mxCell id="d5_n671" value="&lt;b&gt;Datos que se guardan&lt;/b&gt;&lt;br&gt;• Campo editado → origen USUARIO y version + 1 (ficha_marca, canal.editado = true, restaurante.nombre)&lt;br&gt;• Al confirmar: ficha_marca.confirmada_en y restaurante.alta_estado = COMPLETADA" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
