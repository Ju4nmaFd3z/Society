        <mxCell id="d1_title" value="S01A · ACCESO" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontSize=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="2400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1_sub" value="Cómo se lee: izquierda, los datos de la pantalla (notas) · centro, el flujo que sigue el usuario y las funciones que lanza (F1, F2…) · derecha, qué hace cada función por fuera: llamada a la API propia, Edge Function o worker Node, APIs externas y tablas. Ruta Android: Acceso · Ruta en el panel web: /acceso · Pantalla nueva (falta en Figma, propuesta en pantallas_nuevas.html) · P0 · D-04." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="2740" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d1_n150" value="&lt;b&gt;Clases&lt;/b&gt;&lt;br&gt;• Android: AccesoViewModel · AuthRepository (supabase-kt) · RestauranteRepository&lt;br&gt;• Panel web: AccesoStore · SesionService (supabase-js) · RestaurantesApi" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d1_n269" value="&lt;b&gt;Datos que entran&lt;/b&gt;&lt;br&gt;• email · String · obligatorio · formato email · máx. 254&lt;br&gt;• contrasena · String · mín. 8 · nunca se guarda en la app ni en registros&lt;br&gt;• terminosAceptados · Boolean · obligatorio al crear cuenta&lt;br&gt;• pestana · CREAR o ENTRAR (solo estado de pantalla)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="269" width="500" height="131" as="geometry" />
        </mxCell>
        <mxCell id="d1_n418" value="&lt;b&gt;Datos que recibe&lt;/b&gt;&lt;br&gt;• Sesión: JWT de acceso (1 h) + refresh → la guarda supabase-kt / supabase-js&lt;br&gt;• user_id (= auth.users.id)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="418" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d1_n522" value="&lt;b&gt;Datos que se guardan&lt;/b&gt;&lt;br&gt;• auth.users (Supabase Auth; contraseña con hash)&lt;br&gt;• perfil_usuario {id, email, terminos_version, terminos_aceptados_en}: lo crea un trigger al registrarse" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="522" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d1_n626" value="&lt;b&gt;Estado de pantalla&lt;/b&gt;&lt;br&gt;• Formulario(email, pestaña, errores por campo) · Enviando · Error(mensaje) · Hecho(destino)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="626" width="500" height="71" as="geometry" />
        </mxCell>
        <mxCell id="d1_n715" value="&lt;b&gt;Errores&lt;/b&gt;&lt;br&gt;• Credenciales incorrectas · email ya registrado (cambia a Iniciar sesión) · demasiados intentos (límite de Supabase) · SIN_RED" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="715" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d1_n819" value="&lt;b&gt;Navegación&lt;/b&gt;&lt;br&gt;• Desde S01 o cuando la sesión caduca (401 sin refresco posible)&lt;br&gt;• Hacia S02, S03, S04 o S05 según altaEstado" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
