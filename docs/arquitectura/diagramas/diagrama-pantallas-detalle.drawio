          <mxGeometry x="40" y="18" width="2400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d9_sub" value="Cómo se lee: izquierda, los datos de la pantalla (notas) · centro, el flujo que sigue el usuario y las funciones que lanza (F1, F2…) · derecha, qué hace cada función por fuera: llamada a la API propia, Edge Function o worker Node, APIs externas y tablas. Ruta Android: FotosLocal (grafo CrearContenidoGraph) · Ruta en el panel web: /crear/fotos · P0 · D-16, D-32." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="2740" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d9_n150" value="&lt;b&gt;Clases&lt;/b&gt;&lt;br&gt;• Android: CrearContenidoViewModel · RecursoRepository · PiezaRepository · Photo Picker y TakePicture&lt;br&gt;• Panel web: CrearContenidoStore · RecursosApi · PiezasApi · input file y arrastrar y soltar" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d9_n269" value="&lt;b&gt;Datos que entran&lt;/b&gt;&lt;br&gt;• fotos[] · carrusel 2–5, historia 1–3 · galería, cámara o ya subidas (recursoIds)&lt;br&gt;• derechosConfirmados · obligatorio («tengo derechos y permiso de las personas que salen»)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="269" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d9_n388" value="&lt;b&gt;Calculados en el dispositivo&lt;/b&gt;&lt;br&gt;• HEIC o PNG → JPEG · máx. 10 MB&lt;br&gt;• ancho, alto, bytes, mime, sha256 (evita duplicados)&lt;br&gt;• Aviso si el lado corto es menor de 1080 px («Saldrá pixelada»)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="388" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d9_n507" value="&lt;b&gt;Datos que se guardan&lt;/b&gt;&lt;br&gt;• Storage recursos/{userId}/{uuid}.jpg&lt;br&gt;• recurso {storage_path, mime, ancho, alto, bytes, sha256, procedencia GALERIA · CAMARA, naturaleza REAL, categoria, derechos_confirmados}&lt;br&gt;• pieza {formato, idea, tipo, condiciones, referencia_id, campana_id, num_diapositivas, estado BORRADOR → GENERANDO}&lt;br&gt;• pieza_recurso {pieza_id, recurso_id, papel, orden}" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
