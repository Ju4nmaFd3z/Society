        <mxCell id="d0_L0r0c2" value="Si el JWT de acceso caducó, lo renueva con el refresh" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
