          <mxGeometry x="1632" y="604" width="1146" height="124" as="geometry" />
        </mxCell>
        <mxCell id="d4_lane1" value="F2 · cancelar()" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f3f7fd;strokeColor=#1a4fa3;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;fontSize=13;fillColor=#fbfbf8;" vertex="1" parent="1">
          <mxGeometry x="1632" y="450" width="1146" height="124" as="geometry" />
        </mxCell>
        <mxCell id="d4_lane0" value="F1 · seguir(analisisId) — consulta cada 3 s" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f3f7fd;strokeColor=#1a4fa3;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;fontSize=13;fillColor=#fbfbf8;" vertex="1" parent="1">
          <mxGeometry x="1632" y="190" width="1146" height="230" as="geometry" />
        </mxCell>
        <mxCell id="d4_title" value="S03 · ESTUDIANDO TU LOCAL" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontSize=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="2400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d4_sub" value="Cómo se lee: izquierda, los datos de la pantalla (notas) · centro, el flujo que sigue el usuario y las funciones que lanza (F1, F2…) · derecha, qué hace cada función por fuera: llamada a la API propia, Edge Function o worker Node, APIs externas y tablas. Ruta Android: Analisis(analisisId) · Ruta en el panel web: /alta/analisis/:analisisId · P0 · D-08, D-19, D-28." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="2740" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d4_n150" value="&lt;b&gt;Clases&lt;/b&gt;&lt;br&gt;• Android: AnalisisViewModel · AnalisisRepository&lt;br&gt;• Panel web: AnalisisStore · AnalisisApi (timer + switchMap)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d4_n254" value="&lt;b&gt;Datos que entran&lt;/b&gt;&lt;br&gt;• analisisId · argumento de ruta (también en DataStore / localStorage: analisis_en_curso_id)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="254" width="500" height="71" as="geometry" />
        </mxCell>
        <mxCell id="d4_n343" value="&lt;b&gt;Datos que muestra&lt;/b&gt;&lt;br&gt;• estado · EN_COLA · EN_CURSO · COMPLETADO · PARCIAL · ERROR · CANCELADO&lt;br&gt;• pasos[] {orden, fuente GOOGLE_MAPS · WEB · INSTAGRAM · COLORES · FICHA_IA, estado PENDIENTE · EN_CURSO · HECHO · OMITIDO · ERROR, detalle («312 reseñas en Google»)}&lt;br&gt;• tiempoRestanteSeg (D-19) → «Quedan unos N min», redondeado; con 0, «Casi listo…»&lt;br&gt;• progreso = pasos terminados / 5 (calculado en la pantalla)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="343" width="500" height="176" as="geometry" />
        </mxCell>
        <mxCell id="d4_n537" value="&lt;b&gt;Datos que se guardan (los escribe el worker, no la pantalla)&lt;/b&gt;&lt;br&gt;• analisis · paso_analisis (con iniciado_en y terminado_en: base del tiempo restante)&lt;br&gt;• ficha_marca · canal (fuente WEB) · oportunidad · trabajo_generacion&lt;br&gt;• restaurante.alta_estado = PENDIENTE_CONFIRMAR al terminar" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="537" width="500" height="131" as="geometry" />
        </mxCell>
        <mxCell id="d4_n686" value="&lt;b&gt;Estado de pantalla&lt;/b&gt;&lt;br&gt;• Cargando · EnCurso(pasos, progreso, tiempoRestante) · Terminado(parcial) · Error(mensaje, reintentable) · Cancelado" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="686" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d4_n790" value="&lt;b&gt;Consulta periódica&lt;/b&gt;&lt;br&gt;• Cada 3 s; si tarda, espera creciente hasta 10 s; para en estado terminal o a los 5 min (→ Error)&lt;br&gt;• Un fallo de red suelto no detiene la consulta" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d4_n894" value="&lt;b&gt;Reglas del worker&lt;/b&gt;&lt;br&gt;• Cada paso: hasta 3 reintentos (10 s · 30 s · 90 s)&lt;br&gt;• Si falla un paso no crítico, sigue y termina PARCIAL&lt;br&gt;• Reseñas a Gemini solo con el texto, sin nombre de autor (capa gratuita, D-08)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="894" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d4_n1013" value="&lt;b&gt;Navegación&lt;/b&gt;&lt;br&gt;• Desde S02, S02M o el arranque · hacia S04 o S02 (si cancela)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1013" width="500" height="71" as="geometry" />
        </mxCell>
