        <mxCell id="d0_L0r0c3" value="Supabase Auth · POST /auth/v1/token (refresh)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2505" y="226" width="255" height="70" as="geometry" />
