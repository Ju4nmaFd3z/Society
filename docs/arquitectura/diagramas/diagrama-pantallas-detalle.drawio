        <mxCell id="d13_title" value="S13 · PERFIL (Y CONEXIÓN CON INSTAGRAM)" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontSize=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="2400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d13_sub" value="Cómo se lee: izquierda, los datos de la pantalla (notas) · centro, el flujo que sigue el usuario y las funciones que lanza (F1, F2…) · derecha, qué hace cada función por fuera: llamada a la API propia, Edge Function o worker Node, APIs externas y tablas. Ruta Android: Perfil · Ruta en el panel web: /perfil · P0 · D-09, D-30, D-31. El flujo de conexión (F2) es el mismo que usan S04 y S09P." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="2740" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d13_n150" value="&lt;b&gt;Clases&lt;/b&gt;&lt;br&gt;• Android: PerfilViewModel · SesionRepository · InstagramRepository · intent-filter society://instagram&lt;br&gt;• Panel web: PerfilStore · SesionService · InstagramApi" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d13_n254" value="&lt;b&gt;Datos que muestra&lt;/b&gt;&lt;br&gt;• email (Supabase Auth) · nombre del local&lt;br&gt;• Instagram {conectada, usuario, tipoCuenta BUSINESS · CREATOR, expiraEn, estado CONECTADA · CADUCADA · REVOCADA}" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="254" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d13_n358" value="&lt;b&gt;Datos que entran&lt;/b&gt;&lt;br&gt;• Acciones: Datos del local · Conectar · Desconectar · Términos · Cerrar sesión · Eliminar cuenta [P1]" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="358" width="500" height="71" as="geometry" />
        </mxCell>
        <mxCell id="d13_n447" value="&lt;b&gt;Datos que se guardan&lt;/b&gt;&lt;br&gt;• cuenta_social {ig_user_id, usuario, tipo_cuenta, token_cifrado, expira_en, permisos, estado}: el token nunca llega al cliente&lt;br&gt;• oauth_estado {state, user_id, cliente ANDROID · WEB, retorno, caduca_en (10 min), usado_en}&lt;br&gt;• Al cerrar sesión: se borran DataStore / localStorage" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="447" width="500" height="131" as="geometry" />
        </mxCell>
        <mxCell id="d13_n596" value="&lt;b&gt;Vuelta de Instagram&lt;/b&gt;&lt;br&gt;• Android: society://instagram?resultado=ok|error&amp;amp;retorno=S13&lt;br&gt;• Panel web: /perfil?instagram=ok (o /contenido/:id/publicar si retorno = S09P)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="596" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d13_n715" value="&lt;b&gt;Requisitos de Meta&lt;/b&gt;&lt;br&gt;• Cuenta profesional; con acceso estándar solo cuentas con rol en la app (la cuenta de pruebas del equipo para el local ficticio, D-37)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="715" width="500" height="86" as="geometry" />
        </mxCell>
