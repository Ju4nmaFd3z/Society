        </mxCell>
        <mxCell id="d5_n343" value="&lt;b&gt;Datos que muestra y edita&lt;/b&gt;&lt;br&gt;• nombre · 2–80&lt;br&gt;• descripcionCorta · máx. 120&lt;br&gt;• tonos[] · 1–5, máx. 20 caracteres cada uno&lt;br&gt;• fraseEjemplo · máx. 160&lt;br&gt;• colores[] {nombre, hex #RRGGBB, origen, editado} · 0–6&lt;br&gt;• tipografias[] {rol, familia, coincidencia, origen}&lt;br&gt;• canales[] {tipo, valor}&lt;br&gt;• origenPorCampo · GOOGLE · WEB · IA · USUARIO (etiqueta en cada bloque)&lt;br&gt;• version (control de cambios)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
