        </mxCell>
        <mxCell id="d11_n254" value="&lt;b&gt;Datos que entran&lt;/b&gt;&lt;br&gt;• pie · 1–2.200 caracteres (no se usa en historias)&lt;br&gt;• hashtags · 0–5 · # + letras, números o _ (1–30)&lt;br&gt;• textoAlt · máx. 1.000&lt;br&gt;• decisión: publicar por la API o a mano" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
