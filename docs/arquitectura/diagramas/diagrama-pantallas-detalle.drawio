        <mxCell id="d10_sub" value="Cómo se lee: izquierda, los datos de la pantalla (notas) · centro, el flujo que sigue el usuario y las funciones que lanza (F1, F2…) · derecha, qué hace cada función por fuera: llamada a la API propia, Edge Function o worker Node, APIs externas y tablas. Ruta Android: ContenidoCreado(piezaId) · Ruta en el panel web: /contenido/:piezaId · P0 · D-07, D-08, D-16, D-17, D-19, D-32, D-36." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="2740" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d10_n150" value="&lt;b&gt;Clases&lt;/b&gt;&lt;br&gt;• Android: PiezaViewModel · PiezaRepository&lt;br&gt;• Panel web: PiezaStore · PiezasApi" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="500" height="71" as="geometry" />
        </mxCell>
        <mxCell id="d10_n239" value="&lt;b&gt;Datos que entran&lt;/b&gt;&lt;br&gt;• piezaId · ruta&lt;br&gt;• comentario por diapositiva · 3–300 caracteres&lt;br&gt;• posicion de la diapositiva visible" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="239" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d10_n343" value="&lt;b&gt;Datos que muestra&lt;/b&gt;&lt;br&gt;• estado · GENERANDO · GENERADA · ERROR_GENERACION&lt;br&gt;• tiempoRestanteSeg (D-19)&lt;br&gt;• formato · CARRUSEL 1080×1350 o HISTORIA 1080×1920&lt;br&gt;• diapositivas[] {posicion, estado PENDIENTE · GENERANDO · GENERADA · ERROR, funcion, texto, imagenUrl firmada, regeneracionesUsadas 0–3}" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="343" width="500" height="131" as="geometry" />
        </mxCell>
        <mxCell id="d10_n492" value="&lt;b&gt;Datos que se guardan (los escribe el worker)&lt;/b&gt;&lt;br&gt;• diapositiva {recurso_id, version, regeneraciones_usadas}&lt;br&gt;• recurso {naturaleza GENERADO} + Storage generadas/&lt;br&gt;• trabajo_generacion {proveedor, modelo, request_id_remoto, prompt, comentario, coste_estimado_usd}&lt;br&gt;• pieza {pie, hashtags, texto_alt propuestos; estado GENERADA}" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
