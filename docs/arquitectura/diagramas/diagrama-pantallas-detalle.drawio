        <mxCell id="d4_lane3" value="Trabajo ANALISIS · lo ejecuta el worker Node (la pantalla solo lo ve con F1)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f3f7fd;strokeColor=#1a4fa3;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;fontSize=13;fillColor=#fbfbf8;" vertex="1" parent="1">
