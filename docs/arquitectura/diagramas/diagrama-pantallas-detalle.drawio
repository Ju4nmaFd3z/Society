        <mxCell id="d7_CC" value="Funciones · qué hace cada una por fuera (backend, APIs externas y datos)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#8c8c8c;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
