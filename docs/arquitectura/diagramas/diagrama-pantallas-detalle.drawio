        <mxCell id="d0_L0r0c1" value="supabase-kt / supabase-js: lee la sesión guardada" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
