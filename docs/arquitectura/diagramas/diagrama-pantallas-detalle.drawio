        <mxCell id="d7_title" value="S06 · CREAR CONTENIDO · 1 IDEA" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontSize=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="2400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d7_sub" value="Cómo se lee: izquierda, los datos de la pantalla (notas) · centro, el flujo que sigue el usuario y las funciones que lanza (F1, F2…) · derecha, qué hace cada función por fuera: llamada a la API propia, Edge Function o worker Node, APIs externas y tablas. Ruta Android: CrearContenido dentro de CrearContenidoGraph(campanaId?) · Ruta en el panel web: /crear/idea · P0 · D-16." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="2740" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d7_n150" value="&lt;b&gt;Clases&lt;/b&gt;&lt;br&gt;• Android: CrearContenidoViewModel, compartido por S06–S08 (hiltViewModel del grafo anidado)&lt;br&gt;• Panel web: CrearContenidoStore, declarado en los providers de la ruta /crear" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="500" height="101" as="geometry" />
        </mxCell>
        <mxCell id="d7_n269" value="&lt;b&gt;Datos que entran&lt;/b&gt;&lt;br&gt;• formato · CARRUSEL (3–5 imágenes 4:5) o HISTORIA (1–3 pantallas 9:16) · D-16&lt;br&gt;• idea · 10–300 caracteres&lt;br&gt;• tipo · PLATO_ESTRELLA · NOVEDAD · OFERTA · EVENTO&lt;br&gt;• condiciones {precio, fechas, limites} · obligatorias si OFERTA o EVENTO · al menos 1 campo · máx. 120 cada uno&lt;br&gt;• campanaId · opcional (si viene de S11)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="269" width="500" height="146" as="geometry" />
        </mxCell>
        <mxCell id="d7_n433" value="&lt;b&gt;Datos precargados&lt;/b&gt;&lt;br&gt;• Desde S11: idea y tipo sugeridos por la oportunidad (GET /campanas/{id})" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="433" width="500" height="71" as="geometry" />
        </mxCell>
        <mxCell id="d7_n522" value="&lt;b&gt;Datos que se guardan&lt;/b&gt;&lt;br&gt;• Ninguno todavía: el borrador vive en el ViewModel / Store hasta S08 (POST /piezas)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="522" width="500" height="71" as="geometry" />
        </mxCell>
        <mxCell id="d7_n611" value="&lt;b&gt;Por qué las condiciones&lt;/b&gt;&lt;br&gt;• La IA no puede inventar precios ni fechas: solo usa los que escribe el dueño" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="611" width="500" height="71" as="geometry" />
