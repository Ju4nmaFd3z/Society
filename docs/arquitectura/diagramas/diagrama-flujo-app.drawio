        <mxCell id="p1_note_a" value="La sesión se guarda con supabase-kt. Si el token no se puede renovar, se vuelve a S01A. El estado del alta vive en el backend: al reabrir la app se retoma el paso pendiente." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
