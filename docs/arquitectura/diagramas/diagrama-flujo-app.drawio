        <mxCell id="p5_pieza" value="&lt;b&gt;pieza&lt;/b&gt;&lt;br&gt;id · restaurante_id · campana_id? · referencia_id · formato (CARRUSEL|HISTORIA) · idea · tipo · condiciones · estado · pie · hashtags[] (≤ 5) · texto_alt · fecha_prevista · publicada_en · origen_publicacion · ig_media_id · ig_permalink · fotos: pieza_recurso (N:M con recurso)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1900" y="1010" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p5_diapo" value="&lt;b&gt;diapositiva&lt;/b&gt;&lt;br&gt;id · pieza_id · posicion · recurso_id (imagen) · texto · funcion · estado · version · regeneraciones_usadas (≤ 3)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="2310" y="1010" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5_trab" value="&lt;b&gt;trabajo_generacion&lt;/b&gt;&lt;br&gt;id · pieza_id · diapositiva_id? · proveedor · modelo · request_id_remoto · estado · prompt · coste_estimado · error" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="2310" y="1150" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p5_ref" value="&lt;b&gt;referencia_estetica&lt;/b&gt;&lt;br&gt;id · restaurante_id? (null = catálogo) · origen (CATALOGO|USUARIO) · titulo · storage_path" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1900" y="1210" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5_cuenta" value="&lt;b&gt;cuenta_social&lt;/b&gt;&lt;br&gt;id · restaurante_id · plataforma · ig_user_id · usuario · token_cifrado · expira_en · permisos · estado" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1900" y="1340" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5_techNote" value="Tablas técnicas sin relación de negocio: trabajo (cola del worker Node: tipo, estado, intentos, fase, datos, idempotency_key) y oauth_estado (state de la conexión con Instagram)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2310" y="240" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p5_busNote" value="Desde restaurante: todas 1 : N salvo ficha_marca (1 : 1). También 1 : N: analisis → paso_analisis, pieza → diapositiva y pieza → trabajo_generacion." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1570" y="620" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5_erNote" value="Base: ER y DED de Víctor (12/10/2026), pasados de Room (base de datos del móvil) a Postgres, compartido por Android y web. Cambios: listas débiles de la ficha (tonos, colores, tipografías) como columnas JSON; se añaden perfil_usuario, oportunidad, campana, diapositiva, trabajo_generacion, cuenta_social, oauth_estado y trabajo." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1500" width="990" height="120" as="geometry" />
        </mxCell>
