          <mxGeometry x="1230" y="1540" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_secA" value="Secretos SOLO en el servidor. Edge Function: SUPABASE_SERVICE_ROLE_KEY, GOOGLE_MAPS_API_KEY, IG_APP_SECRET, IG_TOKEN_KEY. Worker en Vercel: además GEMINI_API_KEY, HF_API_KEY_ID/SECRET y TRABAJOS_SECRETO. En la app (BuildConfig) y en la web (environment.ts) solo van la URL de Supabase y la clave pública. CORS de la API: solo los orígenes de la web." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff9c4;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1">
