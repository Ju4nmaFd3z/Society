        <mxCell id="p4_b7" value="Clientes: GET /{id} cada 3 s hasta un estado terminal" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
